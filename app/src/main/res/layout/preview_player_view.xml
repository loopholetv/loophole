<?xml version="1.0" encoding="utf-8"?>
<!-- Guide preview. TextureView, not SurfaceView: on Fire TV sticks a SurfaceView under a scrolling
     Compose list costs ~10 ms of render-thread time per frame (measured, Task 11). -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    android:descendantFocusability="blocksDescendants"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit"
    app:shutter_background_color="#FF000000" />
