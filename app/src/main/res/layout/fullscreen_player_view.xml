<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen player. SurfaceView (the cheaper path for full-screen video; nothing scrolls over
     it). Screen-on is set from code (KeepScreenOnWhilePlaying) so an errored player doesn't pin it. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    android:descendantFocusability="blocksDescendants"
    app:surface_type="surface_view"
    app:use_controller="false"
    app:resize_mode="fit"
    app:show_buffering="never"
    app:shutter_background_color="#FF000000" />
